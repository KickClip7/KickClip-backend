{
  "event_classes": [
    "Goal",
    "Shot",
    "Penalty",
    "Card",
    "Corner"
  ],
  "soccer_label_map": {
    "Goal": "Goal",
    "Shots on target": "Shot",
    "Shots off target": "Shot",
    "Penalty": "Penalty",
    "Yellow card": "Card",
    "Red card": "Card",
    "Yellow->red card": "Card",
    "Corner": "Corner"
  },
  "fps": 2.0,
  "window_size": 128,
  "feature_dim": 512,
  "model": {
    "d_model": 256,
    "tcn_channels": 256,
    "nhead": 8,
    "num_transformer_layers": 3,
    "dim_feedforward": 1024,
    "dropout": 0.2,
    "use_eventness_head": true
  },
  "eventness_weight": 0.12,
  "use_feature_augmentation": true,
  "aug_noise_std": 0.03,
  "aug_channel_dropout_p": 0.05,
  "use_balanced_mixup": true,
  "mixup_prob": 0.5,
  "mixup_alpha": 0.2
}
