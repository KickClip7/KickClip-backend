{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kickclip.event_candidate_ranking.v1_1_2a",
  "type": "object",
  "required": [
    "schema_version",
    "package",
    "status",
    "ranking_status",
    "automatic_target_confirmation",
    "production_recommendation_ui",
    "event_context",
    "discovery_snapshot",
    "immutable_candidate_contract",
    "scene_video_duration_contract",
    "freeze",
    "full_gallery_fallback",
    "feature_completeness_state",
    "shortlist",
    "all_candidates",
    "shortlist_decisions"
  ],
  "properties": {
    "schema_version": {
      "const": "kickclip.event_candidate_ranking.v1_1_2a"
    },
    "package": {
      "const": "target_centric_tracking_event_candidate_ranking_v1_1_2a"
    },
    "status": {"const": "PROVISIONAL_SHADOW_ONLY"},
    "ranking_status": {"type": "string"},
    "automatic_target_confirmation": {"const": false},
    "production_recommendation_ui": {"const": "BLOCKED"},
    "event_context": {
      "type": "object",
      "required": [
        "event_id",
        "event_label",
        "event_time_sec",
        "scene_id",
        "scene_start_sec",
        "scene_end_sec",
        "source",
        "client_event_fields_accepted"
      ],
      "properties": {
        "source": {"const": "SERVER_RESOLVED_TIMELINE_EVENT"},
        "client_event_fields_accepted": {"const": false}
      }
    },
    "discovery_snapshot": {
      "type": "object",
      "required": [
        "discovery_id",
        "discovery_artifact_root",
        "scene_id",
        "scene_candidate_manifest_sha256"
      ],
      "properties": {
        "discovery_id": {"type": "string", "minLength": 1},
        "discovery_artifact_root": {"type": "string", "minLength": 1},
        "scene_id": {"type": "string", "minLength": 1},
        "scene_candidate_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "immutable_candidate_contract": {
      "type": "object",
      "required": [
        "current_scene_candidates_sha256",
        "stored_discovery_scene_candidates_sha256",
        "manifest_declared_scene_candidates_sha256"
      ]
    },
    "scene_video_duration_contract": {"type": "object"},
    "freeze": {"type": "object"},
    "full_gallery_fallback": {
      "type": "array",
      "items": {"type": "string"}
    },
    "shot_boundary_input_audit": {
      "type": ["object", "null"],
      "properties": {
        "shot_count": {"type": "integer", "minimum": 0},
        "unapproved_review_count": {"type": "integer", "minimum": 0},
        "frame_count": {"type": "integer", "minimum": 1},
        "covered_frame_count": {"type": "integer", "minimum": 0},
        "missing_frame_count": {"type": "integer", "minimum": 0},
        "duplicate_frame_count": {"type": "integer", "minimum": 0},
        "unknown_candidate_shot_count": {
          "type": "integer",
          "minimum": 0
        },
        "observation_membership_error_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "feature_completeness_state": {
      "enum": ["READY", "PARTIAL_FEATURES", "NO_RELIABLE_SHORTLIST"]
    },
    "feature_completeness_score": {"type": ["number", "null"]},
    "candidate_feature_availability_summary": {
      "type": ["object", "null"],
      "properties": {
        "candidate_count": {"type": "integer", "minimum": 0},
        "actual_candidate_observations_available": {
          "type": "integer",
          "minimum": 0
        },
        "frame_decoding": {
          "type": "object",
          "properties": {
            "decoded_frame_count": {"type": "integer", "minimum": 0},
            "peak_cached_frames": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "shortlist": {
      "type": "array",
      "maxItems": 5,
      "items": {"$ref": "#/$defs/candidateRow"}
    },
    "all_candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidateRow"}
    },
    "shortlist_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "decision", "reason"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "decision": {"enum": ["INCLUDED", "EXCLUDED"]},
          "reason": {"type": "string", "minLength": 1},
          "duplicate_scope": {
            "type": "array",
            "prefixItems": [
              {"type": "string"},
              {"type": "string"}
            ],
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    }
  },
  "$defs": {
    "candidateRow": {
      "type": "object",
      "required": [
        "candidate_id",
        "shot_id",
        "rank",
        "raw_features",
        "feature_completeness_score",
        "reliability_state",
        "event_relevance_score",
        "recommendation_score"
      ],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "shot_id": {"type": "string", "minLength": 1},
        "rank": {"type": "integer", "minimum": 1},
        "shortlist_rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "raw_features": {"type": "object"},
        "feature_completeness_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reliability_state": {
          "enum": [
            "READY",
            "PARTIAL_FEATURES",
            "NO_RELIABLE_SHORTLIST"
          ]
        },
        "event_relevance_score": {"type": "number"},
        "recommendation_score": {"type": "number"}
      }
    }
  }
}
