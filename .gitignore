# =============================================================================
# Generated storage, uploads, renders, and AI artifacts
# =============================================================================

storage/*

# storage/matches 디렉터리 접근 허용
!storage/matches/

# matches 아래는 기본적으로 모두 제외
storage/matches/*

# 팀 공용 목업 경기 디렉터리만 접근 허용
!storage/matches/korjpn_2026/

# 목업 경기 디렉터리 내부도 기본적으로 모두 제외
storage/matches/korjpn_2026/*

# 팀이 공유해야 하는 목업 TimelineEvent fixture만 Git에 포함
!storage/matches/korjpn_2026/timeline_events.json

# 애플리케이션 소스 코드인 app/storage는 추적
!app/storage/
!app/storage/*.py

# 런타임 생성 파일
app/storage/workspaces/
uploads/
downloads/
renders/
outputs/
artifacts/

runs/
wandb/
mlruns/


