# 프로젝트에서 의도적으로 관리하는 Action Spotting 모델 설정/파일
# 위의 models/, *.pth 등의 규칙보다 아래 예외가 나중에 와야 함
!configs/models/
!configs/models/action_spotting/
!configs/models/action_spotting/best_soccer_model/
!configs/models/action_spotting/best_soccer_model/**

# Exact runtime bundle for the current Action Spotting Champion.
!storage/models/
storage/models/*
!storage/models/action_spotting/
storage/models/action_spotting/*
!storage/models/action_spotting/sampling_v1_loss_v2_ms_stem_v1/
!storage/models/action_spotting/sampling_v1_loss_v2_ms_stem_v1/**
!storage/models/action_spotting/sampling_v1_loss_v2_ms_stem_v1/transformer_best.pt
!storage/models/action_spotting/soccer_spotter_v9/
!storage/models/action_spotting/soccer_spotter_v9/v9_best_model.pth

# Training/evaluation reports are outputs, not runtime inputs.
storage/models/**/transformer_history.json
storage/models/**/valid_eval.json


