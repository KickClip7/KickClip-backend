{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kickclip.target_reference_set.v1",
  "type": "object",
  "required": ["selection_id", "scene_id", "source_candidate_id", "references", "artifacts", "provenance"],
  "properties": {
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["reference_id", "source_candidate_id", "frame_index", "bbox_xyxy", "crop_artifact", "quality", "selection_reason"]
      }
    }
  }
}
