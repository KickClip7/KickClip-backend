{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kickclip.target_selection.v1",
  "type": "object",
  "required": [
    "selection_id", "target_selection_revision", "scene_id",
    "selected_candidate_id", "selected_shot_id", "selected_frame_index",
    "selected_bbox_xyxy", "selection_source", "reviewer", "selected_at",
    "earlier_anchor_resolution", "candidate_manifest_sha256"
  ],
  "properties": {
    "selection_id": {"type": "string"},
    "target_selection_revision": {"type": "integer", "minimum": 1},
    "selected_candidate_id": {"type": "string"},
    "selection_source": {"const": "USER_SELECTED_SCENE_WIDE_CANDIDATE"},
    "automatic_target_selection": {"const": false}
  }
}
