# =============================================================================
# KickClip shared mock development overrides
#
# 이 파일은 자동으로 로드되지 않습니다.
# 아래 값을 로컬 .env에 복사하거나 기존 값을 교체하세요.
# 이 파일은 전체 환경 파일이 아니라 목업 개발 시 .env에서 변경해야 할 항목만 모아놓은 설정 예시입니다.
# =============================================================================

ENV=local
KICKCLIP_DEBUG=true

USE_MOCK_DATA=true
MOCK_SHARED_ACCESS_ENABLED=true

# Git으로 공유되는 TimelineEvent fixture의 Match ID
MOCK_TIMELINE_SOURCE_MATCH_ID=korjpn_2026

# 각 팀원의 KickClip-backend 루트에 직접 두는 로컬 영상
# Git에는 올리지 않습니다.
MOCK_VIDEO_SOURCE_PATH=test_data.mp4

# 가능하면 hard link를 만들고, 불가능하면 파일을 복사
MOCK_VIDEO_LINK_MODE=auto

# 프론트와 Agent가 고정적으로 사용할 목업 Match ID
AGENT_DEV_MATCH_ID=korjpn_2026


# 공유 목업 Match 사용에는 Developer mode가 필수는 아닙니다.
# 다른 사용자의 실제 리소스 접근 테스트가 필요할 때만 활성화하세요.
DEVELOPER_MODE_ENABLED=false
DEVELOPER_ACCESS_KEY=""