# KickClip Studio Backend
PROJECT_NAME="KickClip Studio Backend"
SERVICE_NAME="kickclip-backend"
VERSION="0.1.0"

ENV="local"
DEBUG=true

API_V1_PREFIX="/api/v1"

BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

STORAGE_ROOT="storage"

# PostgreSQL
DATABASE_URL="postgresql+psycopg://<DB_USER>:<DB_PASSWORD>@localhost:5432/<DB_NAME>"
DB_ECHO=false

# Authentication (production에서는 반드시 충분히 긴 무작위 값으로 교체)
AUTH_SECRET_KEY="replace-with-at-least-32-random-characters"
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
MEDIA_SIGNED_URL_MINUTES=10

# Developer mode: 다른 사용자 리소스 접근이 필요한 로컬/개발 서버에서만 활성화
DEVELOPER_MODE_ENABLED=false
DEVELOPER_ACCESS_KEY=""
