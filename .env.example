# =============================================================================
# KickClip Studio Backend
# =============================================================================

PROJECT_NAME="KickClip Studio Backend"
SERVICE_NAME="kickclip-backend"
VERSION="0.1.0"

# local, dev, test, production
ENV=local
KICKCLIP_DEBUG=true

API_V1_PREFIX="/api/v1"


# =============================================================================
# CORS
# =============================================================================

BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"


# =============================================================================
# Storage
# =============================================================================

STORAGE_ROOT="storage"


# =============================================================================
# Mock development data
#
# 실제 데이터 흐름이 기본값이 되도록 example에서는 비활성화합니다.
# 목업 개발 시 .env.mock.example의 값을 .env에 적용하세요.
# =============================================================================

USE_MOCK_DATA=false
MOCK_SHARED_ACCESS_ENABLED=false

MOCK_TIMELINE_SOURCE_MATCH_ID=""
MOCK_VIDEO_SOURCE_PATH=""
MOCK_VIDEO_LINK_MODE=auto

AGENT_DEV_MATCH_ID=""


# =============================================================================
# Qwen export metadata assistant
# =============================================================================

QWEN_MODEL_ID="Qwen/Qwen2.5-VL-3B-Instruct"
QWEN_EXPORT_SAMPLE_FRAMES=12
QWEN_MAX_NEW_TOKENS=384


# =============================================================================
# LangGraph export agent
#
# 실제 API 키는 .env에만 입력하고 Git에 올리지 마세요.
# =============================================================================

OPENAI_API_KEY=""
OPENAI_AGENT_MODEL="gpt-4o-mini"
OPENAI_AGENT_TIMEOUT_SECONDS=90


# =============================================================================
# PostgreSQL
#
# 팀원은 자신의 로컬 PostgreSQL 환경에 맞게 수정하세요.
# =============================================================================

DATABASE_URL="postgresql+psycopg://kickclip:kickclip@localhost:5432/kickclip"
DB_ECHO=false

# Optional Action Spotting runtime overrides.
# - AI_PROJECT_ROOT is provenance-only; empty uses this backend project root.
# - PYTHON_EXECUTABLE is used by the SoccerNet/TensorFlow feature-extraction
#   subprocess; empty uses the same Python that runs FastAPI.
# PyTorch Action Spotting itself runs inside the FastAPI process, so torch must
# also be installed in the backend environment (see requirements.txt header).
ACTION_SPOTTING_AI_PROJECT_ROOT=""
ACTION_SPOTTING_PYTHON_EXECUTABLE=""


# =============================================================================
# Authentication
#
# 실제 환경에서는 반드시 충분히 긴 무작위 문자열을 사용하세요.
# =============================================================================

AUTH_SECRET_KEY="replace-with-a-random-secret-key-at-least-32-characters"
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
MEDIA_SIGNED_URL_MINUTES=10


# =============================================================================
# Target-centric tracking (external frozen AI runtime)
#
# 로컬 절대 경로, 모델, 영상, runs 결과는 Git에 커밋하지 마세요.
# =============================================================================

TRACKING_ENABLED=true
TRACKING_PROJECT_ROOT=""
TRACKING_E2E_SCRIPT_PATH=""
TRACKING_SCENE_SELECTION_R3_SCRIPT_PATH=""
TRACKING_VERIFY_SCRIPT_PATH=""
# 예: D:\Users\<name>\anaconda3\envs\yolo-soccer\python.exe
TRACKING_PYTHON_EXECUTABLE=""
TRACKING_OUTPUT_ROOT=""
TRACKING_DEVICE="cuda"
# 현재 API는 명시적 사용자 확인을 보장하는 assisted만 허용합니다.
TRACKING_REACQUISITION_MODE="assisted"
TRACKING_MAX_CONCURRENT_JOBS=1
TRACKING_PROCESS_TIMEOUT_SECONDS=21600
TRACKING_VERIFY_TIMEOUT_SECONDS=300
TRACKING_PREVIEW_ENABLED=true

# Scene Target Selection and R3 are verified separately from generic tracking.
# All paths are absolute and must point at the frozen runtime installation.
# Discovery-only runtime may use COMPAT_R1 independently of selection/R3.
SCENE_DISCOVERY_PROJECT_ROOT=""
SCENE_DISCOVERY_PYTHON_EXECUTABLE=""
SCENE_DISCOVERY_SCRIPT_PATH=""
SCENE_DISCOVERY_VERIFY_SCRIPT_PATH=""
SCENE_DISCOVERY_MANIFEST_PATH=""
SCENE_DISCOVERY_MANIFEST_SHA256=""
SCENE_DISCOVERY_PROCESS_TIMEOUT_SECONDS=21600

SCENE_TARGET_SELECTION_PROJECT_ROOT=""
SCENE_TARGET_SELECTION_PYTHON_EXECUTABLE=""
SCENE_TARGET_SELECTION_SCRIPT_PATH=""
SCENE_TARGET_REVIEWABILITY_SCRIPT_PATH=""
SCENE_TARGET_SELECTION_VERIFY_SCRIPT_PATH=""
SCENE_TARGET_SELECTION_MANIFEST_PATH=""
SCENE_TARGET_SELECTION_MANIFEST_SHA256=""
SCENE_TARGET_SELECTION_PROCESS_TIMEOUT_SECONDS=21600
SCENE_TARGET_SELECTION_MAX_CONFIRMABLE_EARLIER_RANK=5
SCENE_TARGET_SELECTION_MAX_CONCURRENT_JOBS=1
TRACKING_SCENE_SELECTION_VERIFY_SCRIPT_PATH=""
TRACKING_R2_MANIFEST_PATH=""
TRACKING_R2_MANIFEST_SHA256=""
TRACKING_R3_MANIFEST_PATH=""
TRACKING_R3_MANIFEST_SHA256=""
EVENT_CANDIDATE_RANKING_SCRIPT_PATH=""
EVENT_CANDIDATE_RANKING_VERIFY_SCRIPT_PATH=""


# =============================================================================
# Player Candidate Discovery (fine-tuned RF-DETR)
# =============================================================================

PLAYER_DETECTOR_BACKEND=rfdetr
PLAYER_DETECTOR_CHECKPOINT="D:\HAESUNG\prometheus\YOLO-train\weights\rfdetr\checkpoint_best_regular.pth"
PLAYER_DETECTOR_DEVICE=auto
# false prevents a missing/incompatible model from silently switching to HOG.
PLAYER_DETECTOR_ALLOW_HOG_FALLBACK=false
PLAYER_DETECTOR_CONFIDENCE_THRESHOLD=0.25
PLAYER_DETECTOR_BATCH_SIZE=6


# =============================================================================
# Developer mode
#
# 다른 사용자 리소스에 접근해야 하는 로컬 개발 환경에서만 활성화하세요.
# 공유 목업 Match 조회만 필요하다면 활성화하지 않아도 됩니다.
# =============================================================================

DEVELOPER_MODE_ENABLED=false
DEVELOPER_ACCESS_KEY=""
