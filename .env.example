# =============================================================================
# KickClip Studio Backend
# =============================================================================

PROJECT_NAME="KickClip Studio Backend"
SERVICE_NAME="kickclip-backend"
VERSION="0.1.0"

ENV=local
KICKCLIP_DEBUG=true

API_V1_PREFIX="/api/v1"


# =============================================================================
# CORS
# =============================================================================

BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"


# =============================================================================
# Storage / Mock
# =============================================================================

STORAGE_ROOT="storage"

USE_MOCK_DATA=false
MOCK_SHARED_ACCESS_ENABLED=false
AGENT_DEV_MATCH_ID=


# =============================================================================
# Qwen export metadata assistant
# =============================================================================

QWEN_MODEL_ID="Qwen/Qwen2.5-VL-3B-Instruct"
QWEN_EXPORT_SAMPLE_FRAMES=12
QWEN_MAX_NEW_TOKENS=384


# =============================================================================
# OpenAI / LangGraph
# 실제 키는 .env에만 입력하고 Git에 올리지 마세요.
# =============================================================================

OPENAI_API_KEY=
OPENAI_AGENT_MODEL="gpt-4o-mini"
OPENAI_AGENT_TIMEOUT_SECONDS=90


# =============================================================================
# PostgreSQL
# 보안상 실제 접속 문자열 제거
# =============================================================================

DATABASE_URL=
DB_ECHO=false


# =============================================================================
# Authentication
# 실제 운영/개발용 secret은 직접 입력
# =============================================================================

AUTH_SECRET_KEY=
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
MEDIA_SIGNED_URL_MINUTES=10


# =============================================================================
# Developer mode
# 로컬 개발에서만 활성화
# =============================================================================

DEVELOPER_MODE_ENABLED=true
DEVELOPER_ACCESS_KEY=


# =============================================================================
# Canonical Target-Centric Tracking Runtime
#
# 최종 제품 tracking 경로:
# target_centric_tracking_e2e_v1
#   -> target_centric_tracking_v1
#   -> target_centric_tracking_v2
#   -> RF-DETR
#   -> global_ID_tracking_upgrade_v6 / Sports OSNet
#
# global_ID_tracking_upgrade_v7 사용 안 함
# R1/R2/R3 tracking adapter 사용 안 함
# =============================================================================

TRACKING_ENABLED=true

TRACKING_PROJECT_ROOT="tracking_source"

TRACKING_E2E_SCRIPT_PATH="tracking_source/target_centric_tracking_e2e_v1/run_target_centric_pipeline.py"

TRACKING_VERIFY_SCRIPT_PATH="tracking_source/target_centric_tracking_e2e_v1/verify_e2e_installation.py"

TRACKING_PYTHON_EXECUTABLE="venv311/Scripts/python.exe"

# 반드시 backend storage 아래에 유지
TRACKING_OUTPUT_ROOT="storage/tracking_runtime"

TRACKING_DEVICE=auto
TRACKING_REACQUISITION_MODE=assisted

TRACKING_MAX_CONCURRENT_JOBS=1
TRACKING_PROCESS_TIMEOUT_SECONDS=21600
TRACKING_VERIFY_TIMEOUT_SECONDS=300

TRACKING_PREVIEW_ENABLED=true


# =============================================================================
# Scene Discovery
#
# Tracking 알고리즘 자체가 아니라,
# 사용자가 추적할 선수를 선택하기 위한 scene/candidate 준비 단계
# =============================================================================

SCENE_DISCOVERY_PROJECT_ROOT="tracking_source"

SCENE_DISCOVERY_PYTHON_EXECUTABLE="venv311/Scripts/python.exe"

SCENE_DISCOVERY_SCRIPT_PATH="tracking_source/target_centric_tracking_scene_target_selection_v1/run_scene_target_selection.py"

SCENE_DISCOVERY_VERIFY_SCRIPT_PATH="app/domains/candidate_handoff_r1/runtime/verify_scene_target_selection_source.py"

SCENE_DISCOVERY_MANIFEST_PATH="tracking_source/target_centric_tracking_scene_target_selection_v1/scene_target_selection_frozen_manifest.json"

SCENE_DISCOVERY_MANIFEST_SHA256="46c0a48bfdf6c17941cf7f0c420789c3e9e1c6013471fd33707f813f37ce4cae"

SCENE_DISCOVERY_PROCESS_TIMEOUT_SECONDS=21600


# =============================================================================
# Scene Target Selection
#
# 사용자에게 선수 후보를 보여주고 target을 확정하는 단계
# 확정된 target은 canonical E2E tracker로 전달됨
# =============================================================================

SCENE_TARGET_SELECTION_PROJECT_ROOT="tracking_source"

SCENE_TARGET_SELECTION_PYTHON_EXECUTABLE="venv311/Scripts/python.exe"

SCENE_TARGET_SELECTION_SCRIPT_PATH="tracking_source/target_centric_tracking_scene_target_selection_v1/run_scene_target_selection.py"

SCENE_TARGET_SELECTION_VERIFY_SCRIPT_PATH="app/domains/candidate_handoff_r1/runtime/verify_scene_target_selection_source.py"

SCENE_TARGET_SELECTION_MANIFEST_PATH="tracking_source/target_centric_tracking_scene_target_selection_v1/scene_target_selection_frozen_manifest.json"

SCENE_TARGET_SELECTION_MANIFEST_SHA256="46c0a48bfdf6c17941cf7f0c420789c3e9e1c6013471fd33707f813f37ce4cae"

SCENE_TARGET_SELECTION_PROCESS_TIMEOUT_SECONDS=21600
SCENE_TARGET_SELECTION_MAX_CONFIRMABLE_EARLIER_RANK=5
SCENE_TARGET_SELECTION_MAX_CONCURRENT_JOBS=1


# =============================================================================
# Scene Target Reviewability
#
# 현재 tracking_source 구조에
# target_centric_tracking_scene_target_selection_r2가 없으므로
# 존재하지 않는 R2 script를 지정하지 않는다.
# =============================================================================

SCENE_TARGET_REVIEWABILITY_SCRIPT_PATH=


# =============================================================================
# RF-DETR Scene Player Detector
# =============================================================================

PLAYER_DETECTOR_BACKEND="rfdetr"

PLAYER_DETECTOR_CHECKPOINT="<경로>/checkpoint_best_regular.pth"

PLAYER_DETECTOR_DEVICE=auto

# 실제 RF-DETR 실패 시 HOG로 조용히 대체하지 않음
PLAYER_DETECTOR_ALLOW_HOG_FALLBACK=false

# Legacy compatibility field
PLAYER_DETECTOR_CONFIDENCE_THRESHOLD=0.25

PLAYER_DETECTOR_BATCH_SIZE=6


# =============================================================================
# Fine-tuned RF-DETR Soccer Inference Contract
#
# class:
# 0 player
# 1 goalkeeper
# 2 referee
# 3 staff
# 4 ball
# =============================================================================

RFDETR_BASE_CONF_THRESHOLD=0.15


# =============================================================================
# Wide / Live-play Tracking
# =============================================================================

TRACKING_PLAY_CLASSES="0,1"
TRACKING_PLAY_CONF_THRESHOLD=0.15

TRACKING_IOU_THRESHOLD=0.5
TRACKING_TRACKER="botsort"


# =============================================================================
# Close-up / Replay / Observation
# =============================================================================

OBSERVATION_CLASSES="0,1,2,3,4"
OBSERVATION_CONF_THRESHOLD=0.25
OBSERVATION_CROP_TOP_K=3


# =============================================================================
# Close-up Classification
# =============================================================================

CLOSEUP_MIN_BOX_HEIGHT_RATIO=0.35
CLOSEUP_MIN_BOX_AREA_RATIO=0.08


# =============================================================================
# Close-up Crop Eligibility
# =============================================================================

CLOSEUP_CROP_MIN_CONF=0.25
CLOSEUP_CROP_MIN_HEIGHT_RATIO=0.20
CLOSEUP_CROP_MIN_AREA_RATIO=0.03